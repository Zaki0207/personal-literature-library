{
  "name": "personal-literature-library",
  "version": "0.1.10",
  "private": true,
  "main": "desktop/main/index.mjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "dev:web": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "api": "node scripts/library-api.mjs",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern dist-desktop --ignore-pattern release --ignore-pattern .next",
    "desktop:dev": "node scripts/dev-desktop.mjs",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:package": "node scripts/package-desktop.mjs",
    "desktop:install": "node scripts/install-desktop.mjs",
    "desktop:update": "node scripts/update-desktop.mjs",
    "desktop:smoke": "node scripts/smoke-desktop.mjs",
    "library:mcp": "node scripts/library-mcp.mjs"
  },
  "dependencies": {
    "next": "16.3.3",
    "pdfjs-dist": "6.4.299",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "undici": "7.30.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.2",
    "@electron/packager": "20.3.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "electron": "44.7.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "wrangler": "4.127.1"
  },
  "type": "module"
}
